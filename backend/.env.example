# ==============================================================================
# Backend Production Environment Configuration Template
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=production
PROJECT_NAME="Local Food Waste Donation Matcher"
VERSION=0.1.0

# API Documentation Control (Set to false in production to disable public /docs and /redoc)
DOCS_ENABLED=false

# Allowed Frontend Origins for CORS (Comma-separated list e.g. "https://food-helper.vercel.app" or "https://food-helper.vercel.app,http://localhost:3000")
CORS_ORIGINS=https://food-helper.vercel.app

# PostgreSQL + PostGIS Database Connection
# Standard format: postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
DATABASE_URL=postgresql+asyncpg://food_matcher_user:your_secure_password_here@db.example.com:5432/food_matcher_prod
SYNC_DATABASE_URL=postgresql+psycopg2://food_matcher_user:your_secure_password_here@db.example.com:5432/food_matcher_prod

# JWT Authentication & Cryptographic Keys
# Generate via: openssl rand -hex 32
JWT_SECRET_KEY=generate_a_cryptographically_secure_random_64_character_hex_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
