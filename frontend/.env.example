# Food Waste -> Donation Matcher Frontend Environment Configuration

# Public Backend API Gateway URL (FastAPI v1 root)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Public WebSocket URL for Real-time Notifications
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/notifications/ws

# Maps Provider Configuration (OpenStreetMap / Leaflet used by default; no external API key required)
# NEXT_PUBLIC_MAPS_API_KEY=

